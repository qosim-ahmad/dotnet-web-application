{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/src/AdminPanel/AdminPanel.csproj"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": ["watch", "--project", "${workspaceFolder}/src/AdminPanel/AdminPanel.csproj"],
      "problemMatcher": "$msCompile",
      "isBackground": true
    },
    {
      "label": "ef: database update",
      "command": "dotnet",
      "type": "process",
      "args": ["ef", "database", "update", "-p", "${workspaceFolder}/src/AdminPanel"],
      "problemMatcher": []
    }
  ]
}
