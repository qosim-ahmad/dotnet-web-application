{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AdminPanel (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/AdminPanel/bin/Debug/net10.0/AdminPanel.dll",
      "cwd": "${workspaceFolder}/src/AdminPanel",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5022"
      }
    }
  ]
}
