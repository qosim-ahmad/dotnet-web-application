@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1">Selamat datang 👋</h1>
    <p class="text-body-secondary mb-0">Ringkasan kondisi aplikasi saat ini.</p>
</div>

<!-- Kartu statistik -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <partial name="_StatCard" model='("Total User", Model.TotalUsers, "bi-people", "primary")' />
    </div>
    <div class="col-sm-6 col-xl-3">
        <partial name="_StatCard" model='("User Aktif", Model.ActiveUsers, "bi-person-check", "success")' />
    </div>
    <div class="col-sm-6 col-xl-3">
        <partial name="_StatCard" model='("User Nonaktif", Model.InactiveUsers, "bi-person-slash", "danger")' />
    </div>
    <div class="col-sm-6 col-xl-3">
        <partial name="_StatCard" model='("Role", Model.TotalRoles, "bi-shield-lock", "warning")' />
    </div>
</div>

<!-- User terbaru -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-body border-0 pt-3">
        <h2 class="h6 fw-semibold mb-0"><i class="bi bi-clock-history me-2"></i>User Terbaru</h2>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nama</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-end">Terdaftar</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentUsers.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-body-secondary py-4">Belum ada user.</td></tr>
                }
                @foreach (var u in Model.RecentUsers)
                {
                    <tr>
                        <td class="fw-medium">@u.FullName</td>
                        <td>@u.Email</td>
                        <td>
                            @foreach (var r in u.Roles)
                            {
                                <span class="badge text-bg-secondary me-1">@r</span>
                            }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge rounded-pill text-bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill text-bg-danger">Nonaktif</span>
                            }
                        </td>
                        <td class="text-end text-body-secondary">@u.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
