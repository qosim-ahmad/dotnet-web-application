@if (User.Identity?.IsAuthenticated == true)
{
    <div class="dropdown ms-auto">
        <button class="btn btn-link text-body text-decoration-none dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle me-1"></i><span class="d-none d-md-inline">@User.Identity.Name</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li class="d-md-none"><span class="dropdown-item-text small text-body-secondary">@User.Identity.Name</span></li>
            <li class="d-md-none"><hr class="dropdown-divider" /></li>
            <li>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                    </button>
                </form>
            </li>
        </ul>
    </div>
}
