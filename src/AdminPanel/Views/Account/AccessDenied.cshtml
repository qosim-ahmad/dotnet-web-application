@{
    ViewData["Title"] = "Akses Ditolak";
    Layout = "_AuthLayout";
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4 p-sm-5 text-center">
        <div class="auth-logo auth-logo-danger mb-3"><i class="bi bi-shield-x"></i></div>
        <h1 class="h4 fw-bold">Akses Ditolak</h1>
        <p class="text-body-secondary">Akun Anda tidak memiliki izin untuk membuka halaman ini.</p>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-box-arrow-left me-1"></i>Masuk dengan akun lain
            </button>
        </form>
    </div>
</div>
